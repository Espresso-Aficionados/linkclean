rules: linkclean/overlay:utm-prefix
-- ov-marketo-unsubscribe --
note: synthetic (rows 24 and 72 are its negatives): C-3 keeps mkt_tok on a Marketo emailWebview page, against M-8; utm_source still goes
in: https://info.example.com/emailWebview?mkt_tok=MTIzLUFCQy00NTY&utm_source=x
want: https://info.example.com/emailWebview?mkt_tok=MTIzLUFCQy00NTY
rules: linkclean/overlay:marketo-unsubscribe
kept: {"name":"mkt_tok","reason":"rule"}
-- ov-apple-affiliate-keep --
note: synthetic (social-046 shape): no built-in rule strips A-2's names, so an Extra strip stands in for one; the Keep+Affiliate beats it under AffiliateKeep
policy: keep
config: {"Extra":[{"id":"strip-apple-names","action":"strip","include":["*://*/*"],"params":["at","ct","itscg","itsct"]}]}
in: https://music.apple.com/us/album/x/1?i=2&at=1000lAbC&ct=espresso_post&app=music
want: unchanged
rules: linkclean/overlay:apple-affiliate-keep
kept: {"name":"at","reason":"affiliate"}
kept: {"name":"ct","reason":"affiliate"}
-- ov-substack-referral-keep --
note: synthetic (social-053 shape): an Extra strip stands in for a future strip of r; A-3's keep (lowconf) beats it
policy: keep
config: {"Extra":[{"id":"strip-substack-r","action":"strip","include":["*://*.substack.com/*"],"params":["r"]}]}
in: https://x.substack.com/p/y?r=2f8wkh
want: unchanged
rules: linkclean/overlay:substack-referral-keep
kept: {"name":"r","reason":"affiliate"}
-- ov-uppromote-keep --
note: synthetic (commerce-040 shape): an Extra strip stands in for a future strip of sca_ref; A-4's keep beats it
policy: keep
config: {"Extra":[{"id":"strip-sca-ref","action":"strip","include":["*://*/*"],"params":["sca_ref"]}]}
in: https://shop.example.com/products/x?sca_ref=1.AbC
want: unchanged
rules: linkclean/overlay:uppromote-keep
kept: {"name":"sca_ref","reason":"affiliate"}
-- ov-aliexpress-affiliate-keep --
note: synthetic (commerce-021 shape): an Extra strip stands in for a future strip of A-5's names; the keep beats it
policy: keep
config: {"Extra":[{"id":"strip-aliexpress-aff","action":"strip","include":["*://*.aliexpress.com/*"],"params":["aff_fcid","sk"]}]}
in: https://www.aliexpress.com/item/1.html?aff_fcid=a&sk=c&afSmartRedirect=y
want: unchanged
rules: linkclean/overlay:aliexpress-affiliate-keep
kept: {"name":"aff_fcid","reason":"affiliate"}
kept: {"name":"sk","reason":"affiliate"}
-- ov-axs-aff-keep --
note: synthetic: A-10 keep beats Brave's AXS aff strip under AffiliateKeep
policy: keep
in: https://www.axs.com/events/12345/x-tickets?aff=pr1&utm_source=y
want: https://www.axs.com/events/12345/x-tickets?aff=pr1
rules: linkclean/overlay:axs-aff-keep
kept: {"name":"aff","reason":"affiliate"}
-- ov-axs-aff-strip --
note: synthetic: under AffiliateStrip Brave and the A-10 twin both strip aff; the twin makes it an affiliate removal (network AXS, no locator)
policy: strip
in: https://www.axs.com/events/12345/x-tickets?aff=pr1&utm_source=y
want: https://www.axs.com/events/12345/x-tickets
rules: linkclean/overlay:axs-aff-strip
removed: {"part":"query","category":"affiliate","name":"aff","network":"AXS","id":""}
removed: {"part":"query","category":"tracker","name":"utm_source"}
-- ov-gamefound-refcode-keep --
note: synthetic: A-11 (lowconf) keeps refcode under AffiliateKeep; Brave's ref is tracking
policy: keep
in: https://gamefound.com/en/projects/x/y?refcode=AbC123&ref=gf_home
want: https://gamefound.com/en/projects/x/y?refcode=AbC123
rules: linkclean/overlay:gamefound-refcode-keep
kept: {"name":"refcode","reason":"affiliate"}
-- ov-gamefound-refcode-strip --
note: synthetic: under AffiliateStrip refcode is an affiliate removal with its ID (Gamefound referrals, refcode)
policy: strip
in: https://gamefound.com/en/projects/x/y?refcode=AbC123&ref=gf_home
want: https://gamefound.com/en/projects/x/y
rules: linkclean/overlay:gamefound-refcode-strip
removed: {"part":"query","category":"affiliate","name":"refcode","network":"Gamefound referrals","id":"AbC123"}
removed: {"part":"query","category":"tracker","name":"ref"}
-- N1/offline --
note: offline half of network row N1: the clean applied to t.co's destination. The network half (one HTTPS request, the http listener untouched) is package unshorten's (M4); row 97 pins that Clean never touches the network.
in: https://example.net/p?utm_source=x
want: https://example.net/p
-- N2/offline --
note: offline half of network row N2: the amzn.to destination under both policies; linkCode kept per MD-3. The network half is M4.
in: https://www.amazon.com/dp/B0?tag=aff-20&linkCode=ll1&ref_=as_li
want: https://www.amazon.com/dp/B0?tag=aff-20&linkCode=ll1
want-strip: https://www.amazon.com/dp/B0
rules: linkclean/overlay:amazon-affiliate-keep
-- N2/offline-categories --
note: N2's removal categories under AffiliateStrip, in query input order (§3); the CatUnshortened hop is M4's
policy: strip
in: https://www.amazon.com/dp/B0?tag=aff-20&linkCode=ll1&ref_=as_li
want: https://www.amazon.com/dp/B0
rules: linkclean/overlay:amazon-affiliate-strip
hops: none
removed: {"part":"query","category":"affiliate","name":"tag","network":"Amazon Associates","id":"aff-20"}
removed: {"part":"query","category":"affiliate","name":"linkCode","network":"Amazon Associates","id":""}
removed: {"part":"query","category":"tracker","name":"ref_"}
