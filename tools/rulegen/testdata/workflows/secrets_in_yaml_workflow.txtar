A .yaml file is a workflow too, and the exemption is for rules-alert.yml
exactly: rules-alert.yaml gets none. notes.txt is not a workflow and is not
read.
-- rules-alert.yaml --
name: rules-alert
on: workflow_dispatch
permissions: {issues: write}
jobs:
  alert:
    runs-on: ubuntu-24.04
    steps:
      - name: pushover
        env: {PO_USER: "${{ secrets.PUSHOVER_USER_KEY }}"}
        run: |
          r=$(curl -sS --form-string "user=$PO_USER" https://api.pushover.net/1/messages.json)
          echo "$r" | jq -e '.status == 1' >/dev/null
-- notes.txt --
env: {X: ${{ secrets.PUSHOVER_USER_KEY }}}
-- want --
rules-alert.yaml:9 secrets-outside-alert
