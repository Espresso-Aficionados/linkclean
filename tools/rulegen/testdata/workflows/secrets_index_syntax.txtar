secrets['X'] is the secrets context too: the scan matches the word, not
"secrets.".
-- fuzz.yml --
name: fuzz
on: [workflow_dispatch]
permissions: {contents: read}
jobs:
  fuzz:
    runs-on: ubuntu-latest
    steps:
      - env:
          K: ${{ secrets['PUSHOVER_USER_KEY'] }}
        run: go test -run '^$' -fuzz '^FuzzClean$' -fuzztime 10s .
-- want --
fuzz.yml:9 secrets-outside-alert
