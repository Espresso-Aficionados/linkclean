secrets: inherit passes every credential to a called workflow; it is also
outside a step-level env.
-- rules-alert.yml --
name: rules-alert
on: workflow_dispatch
permissions: {issues: write}
jobs:
  alert:
    uses: ./.github/workflows/notify.yml
    secrets: inherit
-- want --
rules-alert.yml:7 secrets-inherit
rules-alert.yml:7 secrets-not-step-env
