A job-level env: hands the credential to every step of the job, third-party
actions included.
-- rules-alert.yml --
name: rules-alert
on: workflow_dispatch
permissions: {issues: write}
jobs:
  alert:
    runs-on: ubuntu-24.04
    env:
      PO_USER: ${{ secrets.PUSHOVER_USER_KEY }}
    steps:
      - run: |
          r=$(curl -sS --form-string "user=$PO_USER" https://api.pushover.net/1/messages.json)
          echo "$r" | jq -e '.status == 1' >/dev/null
-- want --
rules-alert.yml:8 secrets-not-step-env
