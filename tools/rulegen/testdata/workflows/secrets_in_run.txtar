A credential interpolated into run: text becomes part of the script.
-- rules-alert.yml --
name: rules-alert
on: workflow_dispatch
permissions: {issues: write}
jobs:
  alert:
    runs-on: ubuntu-24.04
    steps:
      - name: pushover
        run: |
          r=$(curl -sS --form-string "user=${{ secrets.PUSHOVER_USER_KEY }}" \
                https://api.pushover.net/1/messages.json)
          echo "$r" | jq -e '.status == 1' >/dev/null
-- want --
rules-alert.yml:10 secrets-in-run
rules-alert.yml:10 run-expression
