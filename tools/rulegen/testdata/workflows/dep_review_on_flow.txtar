workflow_run in dep-review.yaml must be the block mapping naming
dep-review-trigger: a bare name in a flow sequence (which would run on no
workflows: filter the scan can check) is reported.
-- dep-review.yaml --
name: dep-review
on: [workflow_run, workflow_dispatch]
permissions: {}
jobs:
  gate:
    uses: sadbox/dep-review/.github/workflows/gate.yml@9fe007b3653f3ccb0b328e70e1bf6f13e45cedaf
-- want --
dep-review.yaml:1 gate-caller
