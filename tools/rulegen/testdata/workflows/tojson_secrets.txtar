toJSON(secrets) hands every credential to the step, even from a
step-level env in rules-alert.yml (the function name is matched without
regard to case).
-- rules-alert.yml --
name: rules-alert
on:
  workflow_dispatch:
    inputs:
      body: {required: true, type: string}
permissions: {issues: write}
jobs:
  alert:
    runs-on: ubuntu-24.04
    steps:
      - name: pushover
        env:
          ALL: ${{ tojson(secrets) }}
        run: |
          r=$(curl -sS --form-string "x=$ALL" https://api.pushover.net/1/messages.json)
          echo "$r" | jq -e '.status == 1' >/dev/null
-- want --
rules-alert.yml:13 tojson-secrets
