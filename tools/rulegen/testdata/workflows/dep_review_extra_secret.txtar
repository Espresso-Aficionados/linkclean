The gate call passes only its three secrets, each as NAME: ${{ secrets.NAME }}
and once: another secret, a name mapped to another secret, a repeated name,
and secrets in with: (also not a literal) all get the usual secrets rules.
-- dep-review.yaml --
name: dep-review
on:
  workflow_run:
    workflows: [dep-review-trigger]
    types: [completed]
  schedule:
    - cron: "17,47 * * * *"
  workflow_dispatch:
permissions: {}
jobs:
  gate:
    uses: sadbox/dep-review/.github/workflows/gate.yml@9fe007b3653f3ccb0b328e70e1bf6f13e45cedaf # v0.1.0
    permissions:
      contents: read
      pull-requests: read
      id-token: write
    secrets:
      DEP_REVIEW_APP_KEY: ${{ secrets.OTHER_TOKEN }}
      PUSHOVER_APP_TOKEN: ${{ secrets.PUSHOVER_APP_TOKEN }}
      PUSHOVER_USER_KEY: ${{ secrets.PUSHOVER_USER_KEY }}
      OTHER_TOKEN: ${{ secrets.OTHER_TOKEN }}
      PUSHOVER_USER_KEY: ${{ secrets.PUSHOVER_USER_KEY }}
    with:
      token: ${{ secrets.DEP_REVIEW_APP_KEY }}
      all: ${{ toJSON(secrets) }}
-- want --
