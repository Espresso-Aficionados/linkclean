secrets in a step's if: or with:, or in a service's or container's env:, is
outside a step-level env:; with: also hands it to an action.
-- rules-alert.yml --
name: rules-alert
on: workflow_dispatch
permissions: {issues: write}
jobs:
  alert:
    runs-on: ubuntu-24.04
    container: {image: "debian:stable", env: {A: "${{ secrets.PUSHOVER_USER_KEY }}"}}
    services:
      cache:
        image: redis
        env:
          B: ${{ secrets.PUSHOVER_APP_TOKEN }}
    steps:
      - if: secrets.PUSHOVER_USER_KEY != ''
        run: echo ok
      - uses: example/notify@0123456789abcdef0123456789abcdef01234567
        with: {token: "${{ secrets.PUSHOVER_APP_TOKEN }}"}
-- want --
rules-alert.yml:7 secrets-not-step-env
rules-alert.yml:12 secrets-not-step-env
rules-alert.yml:14 secrets-not-step-env
rules-alert.yml:17 secrets-not-step-env
