In the step holding the credentials nothing may print them or the response:
the response echoed alone or piped to jq without >/dev/null, a credential
printed, the environment dumped, curl verbose, curl outside a capture, and
the curl command echoed.
-- rules-alert.yml --
name: rules-alert
on: workflow_dispatch
permissions: {issues: write}
jobs:
  alert:
    runs-on: ubuntu-24.04
    steps:
      - name: pushover
        env:
          PO_USER: ${{ secrets.PUSHOVER_USER_KEY }}
          PO_TOKEN: "${{ secrets.PUSHOVER_APP_TOKEN }}"
        run: |
          r=$(curl -sS --form-string "token=$PO_TOKEN" --form-string "user=$PO_USER" \
                https://api.pushover.net/1/messages.json)
          echo "$r"
          echo "$r" | jq .
          printf '%s\n' "$PO_USER" | wc -c
          env | sort
          v=$(curl -sSv --form-string "user=$PO_USER" https://api.pushover.net/1/messages.json)
          curl -sS --form-string "token=$PO_TOKEN" https://api.pushover.net/1/messages.json
          echo curl -sS --form-string "token=$PO_TOKEN"
          echo "$r" | jq -e '.status == 1' >/dev/null && ! grep -qi 'no active devices' <<<"$r"
-- want --
rules-alert.yml:15 secret-output
rules-alert.yml:16 secret-output
rules-alert.yml:17 secret-output
rules-alert.yml:18 secret-output
rules-alert.yml:19 secret-output
rules-alert.yml:20 secret-output
rules-alert.yml:21 secret-output
