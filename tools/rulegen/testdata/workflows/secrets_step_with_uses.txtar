A step-level env reaches the action the step runs, so a step holding
secrets must run a script.
-- rules-alert.yml --
name: rules-alert
on: workflow_dispatch
permissions: {issues: write}
jobs:
  alert:
    runs-on: ubuntu-24.04
    steps:
      - name: notify
        uses: example/notify@0123456789abcdef0123456789abcdef01234567
        env: {PO_USER: "${{ secrets.PUSHOVER_USER_KEY }}"}
-- want --
rules-alert.yml:9 secrets-with-uses
