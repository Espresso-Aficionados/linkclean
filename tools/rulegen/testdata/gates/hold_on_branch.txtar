A synced PR proposes clean-urls bytes X, and a hold on X is committed on the
PR branch: Provenance fails "held: …". Without the hold it passes.
-- ops --
run Provenance
pass
jappend rules/brave/clean-urls.json [0, "params"] "held_change"
relock
run Provenance
pass
-- head/rules/acks.json --
{"schema": 1, "acks": [], "holds": [
  {"file": "brave-lists/clean-urls.json", "sha256": "${sha:rules/brave/clean-urls.json}",
   "expires": "2026-11-15", "reason": "waiting on brave/adblock-lists#1", "by": "fixture"}
]}
-- ops --
run Provenance
fail held: brave-lists/clean-urls.json ${short:rules/brave/clean-urls.json} (waiting on brave/adblock-lists#1, expires 2026-11-15)
