The tree every release fixture starts from, written over the repository's
rules/** and rules.lock.json: small stand-ins for the module's files, one
of each release class. testdata/golden/positive.txtar comes from
golden-positive.txt (a txtar cannot nest).
-- go.mod --
module github.com/Espresso-Aficionados/linkclean

go 1.26.0

require golang.org/x/net v0.59.0

require golang.org/x/text v0.42.0 // indirect
-- go.sum --
golang.org/x/net v0.59.0 h1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
golang.org/x/net v0.59.0/go.mod h1:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
golang.org/x/text v0.42.0 h1:CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC=
golang.org/x/text v0.42.0/go.mod h1:DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD=
-- doc.go --
// Package linkclean removes tracking parameters from URLs.
package linkclean
-- clean.go --
package linkclean

func Clean(s string) string { return s }
