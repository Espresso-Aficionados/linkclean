# lnkd.in interstitial. capture 2026-10-15, by hand before the livenet suite
# existed; scrubbed by hand (TOKENn only; the destination, a third-party
# page, rewritten to example.net with its path shape kept). Only the body
# was captured: the status and Content-Type are assumed. The body is an
# excerpt around the destination anchor; replay pads it to body_len.
-- meta.json --
{"entry":"lnkd.in","strategy":"BodyRegexp","request":"https://lnkd.in/TOKEN1",
 "expect":{"next":"https://example.net/preprints/2026/TOKEN2/","failure":"none","status":0},
 "set_cookie":false,"body":"excerpt","body_len":5225}
-- response --
HTTP/1.1 200
Content-Type: text/html; charset=utf-8
