# bit.ly info_page. capture 2026-10-15, by hand before the livenet suite
# existed; scrubbed by hand (TOKENn only; the destination, a third party's
# campaign link, rewritten to example.net with its path and query shape
# kept). Only the body was captured: the status and Content-Type are
# assumed. The body is an excerpt around the destination anchor; replay
# pads it to body_len. bit.ly is not in DefaultRegistry: the entry is the
# one the package doc's "Not registered by default" section shows.
-- meta.json --
{"entry":"bit.ly","strategy":"BitlyInfo","request":"https://bit.ly/TOKEN1",
 "fetch":"https://bit.ly/TOKEN1+",
 "expect":{"next":"https://example.net/SMSTrackingClick?destinationURL=https://example.net/churner-sms?cid=TOKEN2&PersonContactId=TOKEN2&SMSname=TOKEN3&id=TOKEN4","failure":"none","status":0},
 "set_cookie":false,"body":"excerpt","body_len":15311}
-- response --
HTTP/1.1 200
Content-Type: text/html; charset=utf-8
